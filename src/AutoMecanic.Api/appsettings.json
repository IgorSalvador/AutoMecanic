{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "PostgreSQL": ""
  },

  "Jwt": {
    "Emissor": "AutoMecanic.Api",
    "Audiencia": "AutoMecanic.Clientes",
    "ChaveDeAssinatura": "",
    "ValidadeEmMinutos": 60
  },

  "BancoDeDados": {
    "MigrarNaInicializacao": true,
    "SemearDados": true
  },

  "Seed": {
    "SenhaDoAdministrador": "",
    "IncluirDadosDeDemonstracao": false
  },

  "LimiteDeTaxa": {
    "LoginPorMinuto": 10,
    "GlobalPorMinuto": 300
  },

  "Cors": {
    "OrigensPermitidas": []
  },

  "AllowedHosts": "*"
}
