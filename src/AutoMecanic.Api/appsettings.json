{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "PostgreSQL": ""
  },

  "Jwt": {
    "Emissor": "AutoMecanic.Api",
    "Audiencia": "AutoMecanic.Clientes",
    "ChaveDeAssinatura": "",
    "ValidadeEmMinutos": 60
  },

  "BancoDeDados": {
    "MigrarNaInicializacao": true,
    "SemearDados": true
  },

  "Seed": {
    "SenhaDoAdministrador": "",
    "IncluirDadosDeDemonstracao": false
  },

  "LimiteDeTaxa": {
    "LoginPorMinuto": 10,
    "GlobalPorMinuto": 300,
    "ClientePorMinuto": 30
  },

  "Notificacoes": {
    "Habilitadas": false,
    "UrlPublicaDaApi": "",
    "NomeDaOficina": "AutoMecanic",
    "IntervaloEmSegundos": 5,
    "TamanhoDoLote": 20,
    "MaximoDeTentativas": 5
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Porta": 587,
    "Seguranca": "StartTls",
    "Usuario": "",
    "Senha": "",
    "Remetente": "",
    "NomeDoRemetente": "AutoMecanic"
  },

  "Hospedagem": {
    "UsarCabecalhosEncaminhados": false,
    "RedirecionarParaHttps": true,
    "TempoDeEncerramentoEmSegundos": 30
  },

  "Swagger": {
    "Habilitado": true
  },

  "Cors": {
    "OrigensPermitidas": []
  },

  "AllowedHosts": "*"
}
