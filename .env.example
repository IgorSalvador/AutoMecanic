# Copie este arquivo para .env e ajuste os valores antes de subir o ambiente:
#
#   cp .env.example .env
#   docker compose up -d --build
#
# O arquivo .env está no .gitignore e nunca deve ser versionado.

# --- Banco de dados -------------------------------------------------------
POSTGRES_DB=automecanic
POSTGRES_USER=automecanic
POSTGRES_PASSWORD=troque-esta-senha-do-banco
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# --- JWT ------------------------------------------------------------------
# A chave precisa ter no mínimo 32 caracteres (256 bits) para o HMAC-SHA256.
# Gere uma nova com:  openssl rand -base64 48
JWT_CHAVE=troque-esta-chave-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
JWT_EMISSOR=AutoMecanic.Api
JWT_AUDIENCIA=AutoMecanic.Clientes
JWT_VALIDADE_MINUTOS=60

# --- Carga inicial --------------------------------------------------------
# Senha do usuário admin@automecanic.com.br criado na primeira subida.
# Precisa ter 8+ caracteres com maiúscula, minúscula, dígito e símbolo.
SEED_SENHA_ADMIN=Admin@AutoMecanic2026
# Cria também clientes, veículos e peças de exemplo. Use false em produção.
SEED_DEMO=true

# --- CORS -----------------------------------------------------------------
CORS_ORIGEM=http://localhost:3000
